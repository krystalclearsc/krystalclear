---
/**
 * Animated line icons (Lordicon-style, no external library):
 * strokes draw themselves when the icon scrolls into view, then each icon keeps
 * a small idle motion (ring, twinkle, turn, pulse) and replays on hover.
 * Without JS or with reduced motion they are simply drawn and still.
 */
interface Props { name: keyof typeof icons; size?: number; class?: string; tone?: 'ink' | 'light' }
const icons = {
  phone: { motion: 'ring', d: ['M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z', 'M15 2.5a7 7 0 0 1 6.5 6.5', 'M15 6a3.5 3.5 0 0 1 3 3'] },
  clipboard: { motion: 'pop', d: ['M9 3h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z', 'M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2', 'm8.5 14 2.5 2.5 4.5-5'] },
  key: { motion: 'turn', d: ['M7.5 19.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9z', 'M10.7 12.3 20 3', 'm17 6 3 3', 'm14 9 2 2'] },
  sparkles: { motion: 'twinkle', d: ['M12 3c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6z', 'M19 14.5c.3 1.6 1 2.3 2.5 2.5-1.5.2-2.2.9-2.5 2.5-.3-1.6-1-2.3-2.5-2.5 1.5-.2 2.2-.9 2.5-2.5z', 'M5 15.5c.2 1.1.8 1.7 2 2-1.2.3-1.8.9-2 2-.2-1.1-.8-1.7-2-2 1.2-.3 1.8-.9 2-2z'] },
  shield: { motion: 'pulse', d: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', 'm8.5 12 2.5 2.5 4.5-5'] },
  home: { motion: 'pop', d: ['M3 10.5 12 3l9 7.5', 'M5 9v11h14V9', 'M10 20v-6h4v6', 'M17.5 3.5v3'] },
  building: { motion: 'pop', d: ['M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16', 'M16 9h2a2 2 0 0 1 2 2v10', 'M3 21h18', 'M8 7h4M8 11h4M8 15h4'] },
  box: { motion: 'bounce', d: ['M21 8 12 3 3 8v8l9 5 9-5z', 'M3 8l9 5 9-5', 'M12 13v8', 'm7.5 5.5 9 5'] },
  hammer: { motion: 'tap', d: ['m14 6 4 4', 'M15.5 4.5 19.5 8.5 17 11l-4-4z', 'M13 7 3.5 16.5a2.1 2.1 0 0 0 3 3L16 10'] },
  spray: { motion: 'twinkle', d: ['M8 9h6v11a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z', 'M9 9V6h4v3', 'M13 6h3l1.5-2H11', 'M19.5 7.5h.01M21 10h.01M19.5 12.5h.01'] },
  calendar: { motion: 'pop', d: ['M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z', 'M16 2v4M8 2v4M3 10h18', 'm9 15.5 2 2 4-4'] },
  pin: { motion: 'bounce', d: ['M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z', 'M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z'] },
  heart: { motion: 'pulse', d: ['M19 14c1.5-1.5 3-3.3 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z'] },
  leaf: { motion: 'turn', d: ['M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z', 'M2 21c0-3 1.9-5.4 5.2-6.1C9.6 14.4 12 13 13 12'] },
} as const;
const { name, size = 48, class: cls, tone = 'ink' } = Astro.props;
const icon = icons[name];
---
<span class={['ai', `ai--${icon.motion}`, `ai--${tone}`, cls].filter(Boolean).join(' ')} data-draw style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {icon.d.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} class={i === 0 ? 'ai__main' : 'ai__accent'} />)}
  </svg>
</span>
<style>
  .ai { display: inline-grid; place-items: center; width: var(--s); height: var(--s); }
  .ai svg { width: 100%; height: 100%; overflow: visible; }
  .ai--ink .ai__main { stroke: var(--ink); }
  .ai--ink .ai__accent { stroke: var(--steel); }
  .ai--light .ai__main { stroke: var(--white); }
  .ai--light .ai__accent { stroke: var(--sky); }
  path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(.js) .ai:not(.is-in) path { stroke-dashoffset: 1; }
  :global(.js) .ai.is-in path { transition: stroke-dashoffset 1.1s cubic-bezier(.65, 0, .35, 1) calc(var(--i) * 0.18s); }

  /* idle motions, after the draw-in */
  .ai.is-in svg { animation: var(--anim) 4.5s ease-in-out 1.6s infinite; transform-origin: 50% 50%; }
  .ai--ring { --anim: ai-ring; } .ai--pop { --anim: ai-pop; } .ai--turn { --anim: ai-turn; }
  .ai--twinkle { --anim: ai-twinkle; } .ai--pulse { --anim: ai-pulse; } .ai--bounce { --anim: ai-bounce; } .ai--tap { --anim: ai-tap; }
  .ai:hover svg, :global(.ai-host:hover) .ai svg { animation-duration: 1.2s; animation-delay: 0s; }
  @keyframes ai-ring { 0%, 70%, 100% { transform: rotate(0); } 74% { transform: rotate(-12deg); } 78% { transform: rotate(10deg); } 82% { transform: rotate(-8deg); } 86% { transform: rotate(5deg); } 90% { transform: rotate(0); } }
  @keyframes ai-pop { 0%, 75%, 100% { transform: scale(1); } 85% { transform: scale(1.12); } 92% { transform: scale(0.96); } }
  @keyframes ai-turn { 0%, 70%, 100% { transform: rotate(0); } 82% { transform: rotate(-25deg); } 90% { transform: rotate(6deg); } }
  @keyframes ai-twinkle { 0%, 70%, 100% { transform: scale(1) rotate(0); } 80% { transform: scale(1.15) rotate(12deg); } 90% { transform: scale(0.95) rotate(-4deg); } }
  @keyframes ai-pulse { 0%, 70%, 100% { transform: scale(1); } 78% { transform: scale(1.1); } 86% { transform: scale(1); } 92% { transform: scale(1.06); } }
  @keyframes ai-bounce { 0%, 70%, 100% { transform: translateY(0); } 80% { transform: translateY(-4px); } 88% { transform: translateY(1px); } }
  @keyframes ai-tap { 0%, 70%, 100% { transform: rotate(0); } 78% { transform: rotate(-18deg); } 84% { transform: rotate(6deg); } }
  :global(.motion-paused) .ai svg { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) { .ai svg { animation: none !important; } path { transition: none !important; stroke-dashoffset: 0 !important; } }
</style>
