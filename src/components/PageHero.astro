---
/** Inner-page hero: breadcrumbs, H1, the direct answer (GEO), call/text, and a real photo behind glass. */
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { SITE } from '@/config/site';
import type { PhotoSlug } from '@/data/photos';
interface Props {
  crumbs: { name: string; href: string }[];
  label: string;
  h1: string;
  answer: string;
  photo?: PhotoSlug;
  photoAlt?: string;
  updated?: string;
}
const { crumbs, label, h1, answer, photo, photoAlt = '', updated } = Astro.props;
---
<section class:list={['phero caustics', !photo && 'phero--text']}>
  <div class="wrap phero__grid">
    <div class="phero__copy">
      <Breadcrumbs items={crumbs} />
      <p class="label phero__label">{label}</p>
      <h1>{h1}</h1>
      <p class="lead phero__answer">{answer}</p>
      <div class="phero__ctas">
        <a class="btn" href={SITE.phone.href} data-track="call-page-hero"><Icon name="phone" />Call {SITE.phone.display}</a>
        <a class="btn btn--ghost" href={SITE.phone.sms} data-track="sms-page-hero"><Icon name="message" />Text us</a>
      </div>
      {updated && <p class="phero__updated">Updated <time datetime={updated}>{new Date(updated + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></p>}
    </div>
    {photo && (
      <figure class="phero__media">
        <div class="glass glass--hero phero__glass">
          <Photo slug={photo} alt={photoAlt} sizes="(max-width: 860px) 92vw, 40vw" widths={[420, 640, 800]} priority quality={70} />
          <span class="glass__blade" aria-hidden="true"></span>
        </div>
      </figure>
    )}
  </div>
</section>
<style>
  .phero { padding: calc(var(--header-h) + clamp(36px, 5vw, 72px)) 0 clamp(48px, 6vw, 88px); background: linear-gradient(180deg, var(--paper), var(--white)); overflow: hidden; }
  .phero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .phero--text .phero__grid { grid-template-columns: minmax(0, 860px); }
  .phero__label { margin-top: 26px; }
  .phero h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); margin: 16px 0 22px; }
  .phero__answer { color: var(--ink); opacity: 0.86; }
  .phero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .phero__updated { margin-top: 18px; font-size: 0.85rem; color: var(--muted); }
  .phero__media { margin: 0; }
  .phero__glass { aspect-ratio: 4 / 5; border-radius: 28px 28px 28px 4px; box-shadow: 0 50px 90px -50px rgb(11 34 68 / 0.7); }
  @media (max-width: 860px) {
    .phero__grid { grid-template-columns: 1fr; }
    .phero__media { order: -1; }
    .phero__glass { aspect-ratio: 16 / 11; border-radius: 22px 22px 22px 4px; }
    .phero h1 { font-size: clamp(2.3rem, 9vw, 3rem); }
    .phero__ctas { display: grid; grid-template-columns: 1.4fr 1fr; }
    .phero__ctas .btn { padding: 0 14px; }
  }
</style>
