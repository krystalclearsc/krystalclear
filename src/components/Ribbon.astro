---
/** Tilted "squeegee swipe" band with services and towns moving across. Duplicated track = seamless loop. */
interface Props { items: string[]; tone?: 'ink' | 'steel'; reverse?: boolean; class?: string }
const { items, tone = 'ink', reverse = false, class: cls } = Astro.props;
---
<div class={['ribbon', `ribbon--${tone}`, reverse && 'ribbon--rev', cls].filter(Boolean).join(' ')} aria-hidden="true">
  <div class="marquee">
    {[0, 1].map(() => (
      <div class="marquee-track">
        {items.map((t) => (<><span class="ribbon__item">{t}</span><span class="ribbon__sep">/</span></>))}
      </div>
    ))}
  </div>
</div>
<style>
  .ribbon { position: relative; z-index: 2; transform: rotate(-1.6deg); margin-block: -18px; padding-block: 16px; overflow: hidden; box-shadow: 0 18px 40px -26px rgb(11 34 68 / 0.6); }
  .ribbon--ink { background: var(--ink); color: var(--white); }
  .ribbon--steel { background: var(--steel); color: var(--white); }
  .ribbon__item { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); white-space: nowrap; }
  .ribbon__sep { font-family: var(--font-display); font-style: italic; font-size: clamp(1.4rem, 2.6vw, 2rem); color: var(--sky); }
  .ribbon--rev :global(.marquee-track) { animation-direction: reverse; }
</style>
