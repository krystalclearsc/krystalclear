---
/** FAQ accordion. The page adds the matching FAQPage schema with the same text. */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; openFirst?: boolean }
const { items, openFirst = true } = Astro.props;
---
<div class="faqx">
  {items.map((f, i) => (
    <details class="faqx__item" open={openFirst && i === 0}>
      <summary><h3>{f.q}</h3><Icon name="plus" class="faqx__icon" /></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faqx { display: grid; gap: 12px; }
  .faqx__item { border: 1px solid var(--line); border-radius: 18px; padding: 0 24px; background: var(--white); transition: background-color .3s, border-color .3s; }
  .faqx__item[open] { background: var(--paper); border-color: var(--line-strong); }
  .faqx__item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; cursor: pointer; }
  .faqx__item summary::-webkit-details-marker { display: none; }
  .faqx__item h3 { font-size: 1.12rem; font-weight: 550; }
  :global(.faqx__icon) { width: 22px; height: 22px; flex: none; color: var(--steel-deep); transition: transform .3s var(--ease); }
  .faqx__item[open] :global(.faqx__icon) { transform: rotate(45deg); }
  .faqx__item p { padding: 0 40px 24px 0; color: var(--muted); }
  @media (max-width: 600px) { .faqx__item p { padding-right: 0; } }
</style>
