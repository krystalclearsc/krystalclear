---
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import GoogleG from '@/components/GoogleG.astro';
import Stars from '@/components/Stars.astro';
import Ribbon from '@/components/Ribbon.astro';
import AnimIcon from '@/components/AnimIcon.astro';
import { SITE } from '@/config/site';
import { services, serviceHref } from '@/data/services';
import { areas, areaHref } from '@/data/areas';
import { reviews } from '@/data/reviews';
import { homeFaq } from '@/data/faq';
import { photos } from '@/data/photos';
import { faqNode } from '@/lib/schema';

const title = 'Cleaning Services in Huntington, NY | Krystal Clear';
const description = `House and office cleaning in Huntington, NY by Liza Chamorro's insured, background-checked crew. ${SITE.yearsExperience}+ years, ${SITE.googleRating.value}★ on Google. Call or text ${SITE.phone.display}.`;

/* Poster = first frame of the team video. It is the LCP image, so it is preloaded. */
const poster = await getImage({ src: photos.videoPoster, width: 720, format: 'webp', quality: 70 });

const rooms = [
  { name: 'Kitchen', photo: 'kitchen', alt: 'Cleaner wiping kitchen counters next to wood cabinets', tasks: ['Countertops wiped and disinfected', 'Microwave cleaned inside and out', 'Cups and plates washed', 'All trash taken out'] },
  { name: 'Bathrooms', photo: 'shower', alt: 'Cleaner spraying and wiping the fixtures of a stone walk-in shower', tasks: ['Toilets scrubbed and disinfected', 'Sinks scrubbed and cleaned', 'Tile grime removed and floors mopped', 'Mirrors and glass cleaned'] },
  { name: 'Living and dining', photo: 'diningTable', alt: 'Cleaner polishing a long dining room table under a chandelier', tasks: ['Floors vacuumed and mopped', 'Furniture dusted', 'Windows and mirrors cleaned', 'Fans and lighting dusted'] },
  { name: 'Bedrooms and halls', photo: 'staircase', alt: 'Two Krystal Clear cleaners dusting a staircase railing and landing', tasks: ['Cabinet doors dusted and polished', 'Area rugs vacuumed', 'Phones dusted and disinfected', 'Stair rails and banisters wiped'] },
] as const;

const steps = [
  { icon: 'phone', title: 'Call or text us', text: `Reach Liza's team at ${SITE.phone.display}, or send a request online. Tell us what you need cleaned and when.` },
  { icon: 'clipboard', title: 'Get a clear, free estimate', text: 'We ask about your home or office size, the service you want and its current condition, then give you a price before we start.' },
  { icon: 'key', title: 'We clean, home or away', text: 'Be home, or leave us a key or garage code. Our background-checked, insured crew arrives ready to work.' },
  { icon: 'sparkle', title: 'Quality check before we leave', text: 'Every service includes a quality check before we leave, so nothing is missed and you come back to a home that is ready.' },
] as const;

const ribbon = [...services.map((s) => s.short), ...areas.filter((a) => a.core).map((a) => a.name)];
/* Google-style avatar colors */
const avatar = ['#1A73E8', '#D93025', '#188038', '#E37400', '#9334E6', '#12B5CB', '#C5221F'];
const rowA = reviews;
const rowB = [...reviews.slice(3), ...reviews.slice(0, 3)];
---
<BaseLayout title={title} description={description} path="/" schema={[faqNode(homeFaq)]} headerOverDark preloadImage={poster.src}>

  <!-- 1 · HERO -->
  <section class="hero caustics" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="label hero__label">House &amp; office cleaning · Long Island</p>
        <h1 id="hero-title">Cleaning services in Huntington, NY, <em class="under-stroke">done crystal clear.</em></h1>
        <p class="lead hero__lead">Liza Chamorro and her trained, insured crew have cleaned Long Island homes and offices for {SITE.yearsExperience}+ years. Recurring house cleaning, deep cleans, move-in/move-out, post-construction and commercial cleaning.</p>
        <div class="hero__ctas">
          <a class="btn hero__call" href={SITE.phone.href} data-track="call-hero"><Icon name="phone" />Call {SITE.phone.display}</a>
          <a class="btn btn--ghost hero__sms" href={SITE.phone.sms} data-track="sms-hero"><Icon name="message" />Text us</a>
        </div>
        <a class="hero__chip" href={SITE.listings.google} rel="noopener">
          <GoogleG size={22} />
          <span><strong>{SITE.googleRating.value}</strong> <Stars size={14} /></span>
          <span class="hero__chip-n">{SITE.googleRating.count} Google reviews</span>
        </a>
      </div>

      <figure class="hero__media">
        <div class="glass glass--hero hero__glass">
          <video class="hero__video" data-hero-video muted loop playsinline preload="none" poster={poster.src} width="720" height="800" aria-label="Krystal Clear cleaners at work in Long Island homes">
            <source src="/media/team-at-work.mp4" type="video/mp4" />
          </video>
          <span class="glass__blade" aria-hidden="true"></span>
        </div>
        <button class="hero__vbtn" type="button" data-video-toggle aria-pressed="false">
          <span class="hero__vbtn-ico" aria-hidden="true"></span><span class="sr-only" data-video-label>Pause video</span>
        </button>
        <figcaption class="hero__cap">Our crew at work in Long Island homes.</figcaption>
      </figure>
    </div>
  </section>

  <Ribbon items={ribbon} />

  <!-- 2 · PROOF -->
  <section class="proof liquid" aria-label="Why Long Island families trust Krystal Clear">
    <div class="wrap">
      <ul class="proof__row">
        <li><strong class="display"><span data-count={SITE.yearsExperience}>{SITE.yearsExperience}</span>+</strong><span>years cleaning Long Island homes and offices</span></li>
        <li><strong class="display"><span data-count={SITE.googleRating.value}>{SITE.googleRating.value}</span><GoogleG size={28} class="proof__g" /></strong><span>Google rating from {SITE.googleRating.count} reviews</span></li>
        <li><strong class="display"><span data-count="18">18</span> yrs</strong><span>with some of our clients, in their own words</span></li>
        <li class="ai-host"><AnimIcon name="shield" size={52} tone="light" /><span>Insured and background-checked team · Women- and Latino-owned</span></li>
      </ul>
    </div>
  </section>

  <!-- 3 · SERVICES -->
  <section class="section svc cv" id="services" aria-labelledby="svc-title">
    <div class="wrap svc__grid">
      <div>
        <p class="label">01 — Services</p>
        <h2 id="svc-title" data-split>One crew for every kind of <em>clean</em></h2>
        <p class="lead svc__lead">From weekly upkeep to the dust after a renovation, each service has its own checklist. Pick one, or ask us which fits your space.</p>
        <ol class="svc__list">
          {services.map((s, i) => (
            <li data-svc-row={String(i)}>
              <a href={serviceHref(s)} class="svc__row spot">
                <span class="svc__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc__thumb"><Photo slug={s.photo} alt="" sizes="88px" widths={[180]} /></span>
                <span class="svc__body">
                  <span class="svc__name">{s.short}</span>
                  <span class="svc__sum">{s.summary}</span>
                </span>
                <span class="svc__tag">{s.audience}</span>
                <Icon name="arrow-up-right" class="svc__arrow" />
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="svc__preview" data-svc-preview aria-hidden="true">
        {services.map((s, i) => (
          <div class={`svc__frame${i === 0 ? ' is-active' : ''}`} data-svc-frame={String(i)}>
            <Photo slug={s.photo} alt="" sizes="(max-width: 980px) 0px, 36vw" widths={[480, 640]} />
          </div>
        ))}
        <span class="svc__label">{services[0].audience} · Huntington, NY</span>
      </div>
    </div>
  </section>

  <!-- 4 · ROOMS (dark, pinned) -->
  <section class="section rooms on-dark cv" aria-labelledby="rooms-title">
    <div class="rooms__glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="rooms__head">
        <p class="label">02 — What a clean includes</p>
        <h2 id="rooms-title" data-split>Room by room, <em>nothing skipped</em></h2>
        <p class="lead">This is the checklist our house cleaning follows. Deep cleans and move-outs add baseboards, inside cabinets and appliances.</p>
      </div>
      <div class="rooms__grid" data-room-stage>
        <div class="rooms__stage">
          <div class="rooms__frame">
            {rooms.map((r, i) => (
              <div class={`rooms__shot${i === 0 ? ' is-active' : ''}`} data-room-shot={String(i + 1)}>
                <Photo slug={r.photo} alt={r.alt} sizes="(max-width: 860px) 0px, 40vw" widths={[480, 720]} eager={i > 0} />
              </div>
            ))}
            <span class="rooms__count"><span data-room-count>01</span> / 0{rooms.length}</span>
          </div>
        </div>
        <ol class="rooms__list">
          {rooms.map((r, i) => (
            <li class="rooms__item" data-room={String(i + 1)}>
              <span class="rooms__n">0{i + 1}</span>
              <h3 class="rooms__name">{r.name}</h3>
              <ul>{r.tasks.map((t) => <li><Icon name="check" />{t}</li>)}</ul>
              <div class="rooms__mobile-shot"><Photo slug={r.photo} alt="" sizes="92vw" widths={[480, 720]} /></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 5 · FIXED WINDOW -->
  <section class="window corner" aria-labelledby="corner-title">
    <div class="window__media" aria-hidden="true"><Photo slug="triptych" alt="" sizes="100vw" widths={[800, 1280, 1920]} quality={64} /></div>
    <div class="window__shade corner__shade"></div>
    <div class="wrap corner__inner">
      <span class="stroke corner__stroke" aria-hidden="true"></span>
      <h2 id="corner-title" class="corner__title" data-split>Every corner.<br /><em>Every visit.</em></h2>
      <p class="corner__text">The same checklist, the same care, whether it's your first deep clean or your regular weekly visit.</p>
    </div>
  </section>

  <!-- 6 · PROCESS -->
  <section class="section steps caustics cv" aria-labelledby="steps-title">
    <div class="wrap">
      <p class="label">03 — How it works</p>
      <h2 id="steps-title" data-split>From first call to a <em>spotless</em> home</h2>
      <ol class="steps__list" data-steps>
        {steps.map((s, i) => (
          <li class="steps__item spot ai-host" data-rise>
            <span class="steps__dot"><AnimIcon name={s.icon === 'sparkle' ? 'sparkles' : s.icon} size={30} tone="light" /></span>
            <span class="steps__n">Step {i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7 · LIZA -->
  <section class="section liza cv" aria-labelledby="liza-title">
    <div class="wrap liza__grid">
      <figure class="liza__media">
        <div class="glass liza__glass" data-fog>
          <Photo slug="liza" alt="Liza Chamorro, owner of Krystal Clear Services" sizes="(max-width: 860px) 80vw, 34vw" widths={[400, 600, 832]} position="50% 25%" />
          <span class="glass__blade" aria-hidden="true"></span>
        </div>
        <figcaption>Liza Chamorro, owner</figcaption>
      </figure>
      <div class="liza__copy">
        <p class="label">04 — The person behind the name</p>
        <h2 id="liza-title" data-split>Meet Liza Chamorro, <em>owner</em></h2>
        <ul class="liza__chips">{SITE.attributes.map((a) => <li>{a}</li>)}<li>{SITE.yearsExperience}+ years</li></ul>
        <p class="lead">Krystal Clear is Liza Chamorro's company: a women- and Latino-owned team based in Huntington Station that has cleaned for local families and businesses for more than two decades.</p>
        <p class="muted">Some clients have been with Liza for 18 years, including a real estate agent who recommends Krystal Clear for whole-house deep cleans. Every cleaning plan is built around the home, the schedule and the standards of the people who live there.</p>
        <blockquote class="liza__quote">
          <p>“Liza and her team are amazing! They are very thorough and do a great professional job. Every detail is covered.”</p>
          <cite><GoogleG size={16} /> Nicole P., Google review</cite>
        </blockquote>
        <a class="link-arrow" href="/about/">Read Liza's story <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 8 · REVIEWS (Google style) -->
  <section class="section reviews cv" id="reviews" aria-labelledby="reviews-title">
    <div class="wrap reviews__head">
      <div>
        <p class="label">05 — Reviews</p>
        <h2 id="reviews-title" data-split>In our clients' <em>own words</em></h2>
      </div>
      <div class="gsum">
        <div class="gsum__brand"><GoogleG size={34} /><span>Google Reviews</span></div>
        <div class="gsum__score">
          <strong>{SITE.googleRating.value}</strong>
          <span><Stars size={20} /><span class="gsum__n">Based on {SITE.googleRating.count} reviews</span></span>
        </div>
        <a class="gsum__btn" href={SITE.listings.google} rel="noopener">See all on Google <Icon name="arrow-up-right" /></a>
      </div>
    </div>

    <div class="reviews__rows">
      {[rowA, rowB].map((row, r) => (
        <div class={`marquee reviews__marquee${r === 1 ? ' is-rev' : ''}`} style={`--dur:${r === 0 ? 70 : 82}s;--gap:18px`}>
          {[0, 1].map((copy) => (
            <ul class="marquee-track reviews__track" aria-hidden={copy === 1 || r === 1 ? 'true' : undefined}>
              {row.map((rv, i) => (
                <li class="gcard">
                  <div class="gcard__top">
                    <span class="gcard__av" style={`background:${avatar[(i + r * 3) % avatar.length]}`} aria-hidden="true">{rv.name[0]}</span>
                    <span class="gcard__who"><strong>{rv.name}</strong><span>{rv.tag ?? 'Google review'}</span></span>
                    <GoogleG size={20} class="gcard__g" />
                  </div>
                  <Stars size={16} />
                  <p class="gcard__text">{rv.text}</p>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
    </div>
    <div class="wrap reviews__foot">
      <button type="button" class="btn btn--ghost reviews__pause" data-motion-toggle aria-pressed="false"><Icon name="close" class="sr-only" /><span data-motion-label>Pause motion</span></button>
      <p class="muted">Reviews copied from Krystal Clear's public Google Business Profile.</p>
    </div>
  </section>

  <!-- 9 · AREAS over a fixed photo of Northport -->
  <section class="window areas on-dark" aria-labelledby="areas-title">
    <div class="window__media" aria-hidden="true"><Photo slug="northportDock" alt="" sizes="100vw" widths={[800, 1280, 1800]} quality={60} /></div>
    <div class="window__shade areas__shade"></div>
    <div class="wrap areas__grid">
      <div>
        <p class="label">06 — Where we clean</p>
        <h2 id="areas-title" data-split>Huntington and the <em>North Shore</em></h2>
        <p class="lead">Based in {SITE.baseCity}, we clean homes and businesses across Suffolk County and nearby Nassau towns. Not sure if we reach you? Call or text and we'll tell you right away.</p>
        <a class="btn btn--light areas__cta" href={SITE.phone.sms} data-track="sms-areas"><Icon name="message" />Text us your town</a>
      </div>
      <div class="areas__map">
        <p class="areas__base"><Icon name="pin" />Base · {SITE.baseCity}</p>
        <ul class="areas__list">
          {areas.map((a) => (
            <li class={a.core ? 'is-core' : undefined}>
              {a.page ? <a href={areaHref(a)}>{a.name}</a> : <span>{a.name}</span>}
              <small>{a.county}</small>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 10 · FAQ -->
  <section class="section faq cv" aria-labelledby="faq-title">
    <div class="wrap faq__grid">
      <div class="faq__side">
        <p class="label">07 — Questions</p>
        <h2 id="faq-title" data-split>Before you <em>book</em></h2>
        <p class="muted">Anything else? Call or text {SITE.phone.display}.</p>
        <a class="link-arrow" href="/faq/">All questions <Icon name="arrow" /></a>
      </div>
      <div class="faq__list">
        {homeFaq.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary><h3>{f.q}</h3><Icon name="plus" class="faq__icon" /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11 · CLOSE -->
  <section class="close cv" aria-labelledby="close-title">
    <div class="wrap">
      <div class="close__panel on-dark">
        <div class="glass close__glass" data-fog aria-hidden="true">
          <Photo slug="shower" alt="" sizes="100vw" widths={[640, 960]} />
          <span class="glass__blade"></span>
        </div>
        <div class="close__copy">
          <p class="label">Free estimate</p>
          <h2 id="close-title" data-split>Ready for a home that's <em>crystal clear?</em></h2>
          <p class="lead">Call or text Liza's team. We'll ask a few questions and give you a clear price.</p>
          <div class="hero__ctas">
            <a class="btn btn--light" href={SITE.phone.href} data-track="call-close"><Icon name="phone" />Call {SITE.phone.display}</a>
            <a class="btn btn--outline-light" href={SITE.phone.sms} data-track="sms-close"><Icon name="message" />Text us</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero { padding: calc(var(--header-h) + clamp(40px, 6vw, 84px)) 0 clamp(64px, 7vw, 104px); background: linear-gradient(180deg, var(--paper), var(--white)); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .hero h1 { margin: 22px 0 26px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero__chip { display: inline-flex; align-items: center; gap: 12px; margin-top: 26px; padding: 10px 18px 10px 12px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); color: var(--ink); text-decoration: none; box-shadow: 0 10px 30px -20px rgb(11 34 68 / 0.5); font-size: 0.95rem; }
  .hero__chip strong { font-size: 1.05rem; }
  .hero__chip-n { color: var(--muted); }
  .hero__chip:hover { border-color: var(--line-strong); color: var(--ink); }
  .hero__media { position: relative; margin: 0; }
  .hero__glass { aspect-ratio: 9 / 10; border-radius: 28px 28px 28px 4px; box-shadow: 0 50px 90px -50px rgb(11 34 68 / 0.7); }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__vbtn { position: absolute; right: 14px; top: 14px; z-index: 4; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.5); background: rgb(11 34 68 / 0.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); cursor: pointer; display: grid; place-items: center; }
  .hero__vbtn-ico { width: 12px; height: 14px; border-inline: 4px solid var(--white); }
  .hero__vbtn[aria-pressed='true'] .hero__vbtn-ico { border: 0; width: 0; height: 0; border-left: 12px solid var(--white); border-block: 7px solid transparent; margin-left: 3px; }
  .hero__cap { display: flex; gap: 12px; margin-top: 14px; font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; }

  /* ===== PROOF ===== */
  .proof { padding-top: 40px; padding-bottom: 14px; margin-top: -8px; }
  .proof__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .proof__row li { display: grid; gap: 6px; align-content: start; padding: 34px 28px; border-left: 1px solid rgb(255 255 255 / 0.25); }
  .proof__row li:first-child { border-left: 0; padding-left: 0; }
  .proof__row strong { font-size: clamp(2.6rem, 4.4vw, 3.6rem); font-weight: 400; line-height: 1; display: inline-flex; align-items: center; font-variant-numeric: tabular-nums; }
  .proof__row strong :global(.proof__g) { margin-left: 10px; }
  .proof__row > li > span { color: rgb(255 255 255 / 0.88); font-size: 0.95rem; max-width: 22ch; }
  .proof__row strong :global(.proof__g) { background: var(--white); border-radius: 50%; padding: 4px; width: 34px; height: 34px; }
  :global(.proof__ico) { width: 42px; height: 42px; color: var(--steel); }

  /* ===== SERVICES ===== */
  .svc__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(32px, 6vw, 80px); }
  .svc h2 { margin-top: 18px; }
  .svc__lead { margin-top: 18px; }
  .svc__list { list-style: none; margin: 44px 0 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .svc__row { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto 28px; gap: 18px; align-items: center; padding: 26px 8px; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; position: relative; overflow: hidden; border-radius: 4px; transition: padding .35s var(--ease); }
  .svc__row > * { position: relative; z-index: 1; }
  .svc__row::after { content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: 0; background: linear-gradient(90deg, var(--steel), var(--sky)); transition: width .5s var(--ease); }
  .svc__row:hover, .svc__row:focus-visible { padding-left: 18px; color: var(--ink); }
  .svc__row:hover::after, .svc__row:focus-visible::after { width: 100%; }
  .svc__thumb { display: none; }
  .svc__n { font-family: var(--font-display); font-size: 1.25rem; color: var(--steel-deep); }
  .svc__body { display: grid; gap: 6px; }
  .svc__name { font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1.05; }
  .svc__sum { color: var(--muted); font-size: 0.975rem; max-width: 46ch; }
  .svc__tag { font-size: 0.8rem; font-weight: 550; padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 999px; white-space: nowrap; color: var(--muted); background: var(--white); }
  :global(.svc__arrow) { width: 24px; height: 24px; color: var(--steel-deep); transition: transform .35s var(--ease); }
  .svc__row:hover :global(.svc__arrow) { transform: translate(3px, -3px); }
  .svc__preview { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; aspect-ratio: 4 / 5; margin-top: 120px; }
  .svc__preview::before { content: ''; position: absolute; inset: 18px -18px -18px 18px; border: 1px solid var(--steel); border-radius: 24px 4px 24px 24px; opacity: 0.5; }
  .svc__frame { position: absolute; inset: 0; border-radius: 24px 4px 24px 24px; overflow: hidden; opacity: 0; transform: scale(1.04); transition: opacity .5s var(--ease), transform .9s var(--ease); box-shadow: 0 40px 70px -40px rgb(11 34 68 / 0.6); }
  .svc__frame.is-active { opacity: 1; transform: none; }
  .svc__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .svc__label { position: absolute; left: 16px; bottom: 16px; z-index: 2; padding: 8px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.9); font-size: 0.8rem; font-weight: 550; }

  /* ===== ROOMS ===== */
  .rooms { overflow: clip; }
  .rooms__glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(50% 40% at 85% 10%, rgb(46 126 175 / 0.45), transparent 70%), radial-gradient(40% 40% at 0% 90%, rgb(159 211 242 / 0.14), transparent 70%); }
  .rooms__head { max-width: 760px; position: relative; }
