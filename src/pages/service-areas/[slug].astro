---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import AnimIcon from '@/components/AnimIcon.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import ReviewCards from '@/components/ReviewCards.astro';
import CtaBand from '@/components/CtaBand.astro';
import Photo from '@/components/Photo.astro';
import { services, serviceHref } from '@/data/services';
import { areas, areaHref } from '@/data/areas';
import { areaPages } from '@/data/area-pages';
import { abs, faqNode, serviceNode } from '@/lib/schema';

export function getStaticPaths() {
  return areas.filter((a) => a.page).map((a) => ({ params: { slug: a.slug } }));
}
const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const page = areaPages[slug!];
const path = areaHref(area);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Service areas', href: '/service-areas/' }, { name: area.name, href: path }];
const nearby = page.nearby.map((s) => areas.find((a) => a.slug === s)).filter(Boolean) as typeof areas;
const icons = ['home', 'sparkles', 'box', 'hammer', 'building'] as const;
---
<BaseLayout
  title={page.title}
  description={page.description}
  path={path}
  breadcrumbs={crumbs.slice(1)}
  schema={[serviceNode({ name: `Cleaning services in ${area.name}, NY`, description: page.answer, url: abs(path), areaServed: `${area.name}, NY` }), faqNode(page.faq)]}
>
  <PageHero crumbs={crumbs} label={`${area.county} County · Long Island`} h1={page.h1} answer={page.answer} photo="vacuumFoyer" photoAlt={`Krystal Clear cleaner vacuuming a home entrance, serving ${area.name}`} />

  <section class="section local">
    <div class="wrap local__grid">
      <div>
        <p class="label">Local team</p>
        <h2 data-split>Cleaning in {area.name}, <em>by neighbors</em></h2>
        {page.local.map((p) => <p class="local__p">{p}</p>)}
      </div>
      <div class="window local__photo" aria-hidden="true">
        <div class="window__media"><Photo slug={slug === 'northport' ? 'northportDock' : 'triptych'} alt="" sizes="(max-width: 860px) 92vw, 44vw" widths={[640, 960, 1280]} quality={60} /></div>
        <div class="window__shade local__shade"></div>
        <p class="local__tag ai-host"><AnimIcon name="pin" size={40} tone="light" /><span>{area.name}, NY</span></p>
      </div>
    </div>
  </section>

  <section class="section svcs liquid cv" aria-labelledby="svcs-title">
    <div class="wrap">
      <p class="label">Services in {area.name}</p>
      <h2 id="svcs-title" data-split>Everything we clean in <em>{area.name}</em></h2>
      <ul class="svcs__grid">
        {services.map((s, i) => (
          <li><a href={serviceHref(s)} class="svcs__card ai-host"><AnimIcon name={icons[i]} size={42} tone="light" /><span class="svcs__name">{s.short}</span><span class="svcs__sum">{s.summary}</span><Icon name="arrow-up-right" class="svcs__arrow" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section cv" aria-labelledby="ar-revs">
    <div class="wrap">
      <p class="label">Reviews</p>
      <h2 id="ar-revs" data-split>Trusted on <em>Long Island</em></h2>
      <div class="ar__cards"><ReviewCards names={['Kim B.', 'Michele P.', 'Tara P.']} /></div>
    </div>
  </section>

  <section class="section ar-faq cv" aria-labelledby="ar-faq">
    <div class="wrap ar-faq__grid">
      <div>
        <p class="label">Questions</p>
        <h2 id="ar-faq" data-split>{area.name} <em>FAQ</em></h2>
        <p class="label ar-near">Nearby areas</p>
        <ul class="chips">{nearby.map((a) => <li>{a.page ? <a href={areaHref(a)}>{a.name}</a> : <span>{a.name}</span>}</li>)}<li><a href="/service-areas/">All areas</a></li></ul>
      </div>
      <Faq items={page.faq} />
    </div>
  </section>

  <CtaBand title={`Book a cleaning in ${area.name}`} />
</BaseLayout>

<style>
  .local__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .local h2 { margin: 18px 0 8px; }
  .local__p { margin-top: 16px; font-size: 1.1rem; }
  .local__photo { min-height: 380px; border-radius: 28px 4px 28px 28px; overflow: hidden; display: grid; align-items: end; }
  .local__shade { background: linear-gradient(0deg, rgb(11 34 68 / 0.85), rgb(11 34 68 / 0.1) 60%); }
  .local__tag { display: flex; align-items: center; gap: 12px; padding: 24px; color: var(--white); font-family: var(--font-display); font-size: 2rem; }
  .svcs h2 { margin: 18px 0 36px; }
  .svcs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 14px; }
  .svcs__card { position: relative; display: grid; gap: 10px; height: 100%; padding: 24px; border-radius: 20px; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.25); color: var(--white); text-decoration: none; transition: background-color .3s, transform .3s var(--ease); }
  .svcs__card:hover { background: rgb(255 255 255 / 0.2); color: var(--white); transform: translateY(-3px); }
  .svcs__name { font-family: var(--font-display); font-size: 1.7rem; line-height: 1.05; }
  .svcs__sum { font-size: 0.92rem; color: rgb(255 255 255 / 0.88); }
  :global(.svcs__arrow) { position: absolute; top: 20px; right: 20px; width: 20px; height: 20px; }
  .ar__cards { margin-top: 28px; }
  .ar-faq__grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(32px, 6vw, 80px); }
  .ar-faq h2 { margin: 18px 0; }
  .ar-near { margin-top: 26px; }
  .chips { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a, .chips span { display: inline-block; padding: 9px 16px; border-radius: 999px; font-size: 0.92rem; text-decoration: none; }
  .chips a { background: var(--ice); color: var(--ink); font-weight: 550; }
  .chips a:hover { background: var(--ink); color: var(--white); }
  .chips span { border: 1px solid var(--line-strong); color: var(--muted); }
  @media (max-width: 860px) { .local__grid, .ar-faq__grid { grid-template-columns: 1fr; } }
</style>
