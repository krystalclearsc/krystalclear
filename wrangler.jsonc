{
  // Cloudflare Workers (static assets). Build: `npm run build` -> ./dist, deploy: `npx wrangler deploy`
  "name": "krystalclear-website",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // real 404 status + our custom 404 page
    "not_found_handling": "404-page",
    // /about -> /about/ (matches canonicals and sitemap)
    "html_handling": "force-trailing-slash"
  }
}
